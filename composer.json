        "magento/module-backend": ">=101.0.1 <=103.0.9",
        "magento/module-bundle": ">=100.3.1 <=101.0.9",
        "magento/module-catalog": ">=103.0.1 <=105.0.9",
        "magento/module-catalog-import-export": ">=101.0.1 <=101.1.9",
        "magento/module-checkout": ">=100.3.1 <=100.5.9",
        "magento/module-config": ">=101.1.1 <=102.0.9",
        "magento/module-configurable-product": ">=100.3.1 <=100.4.9",
        "magento/module-customer": ">=102.0.1 <=104.0.9",
        "magento/module-directory": ">=100.3.1 <=100.5.9",
        "magento/module-eav": ">=102.0.1 <=102.1.9",
